[Unit]
Description=Run the Money Badger sync
# One OnCalendar line per pass. Changing them later takes a daemon-reload and a
# restart of this timer — and note that Persistent=true makes systemd replay a
# trigger it considers missed, so a restart after a time that has already passed
# today runs a pass immediately.

[Timer]
{{SYNC_TIMES}}
Persistent=true

[Install]
WantedBy=timers.target
