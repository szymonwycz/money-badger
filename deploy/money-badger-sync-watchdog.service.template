[Unit]
Description=Money Badger - retry if no scheduled sync pass succeeded today
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{USER}}
WorkingDirectory={{DIR}}
EnvironmentFile={{DIR}}/.env
TimeoutStartSec=35min
ExecStart={{DIR}}/venv/bin/python3 {{DIR}}/watchdog.py
