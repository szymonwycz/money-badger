[Unit]
Description=Money Badger sync watchdog - retries if no pass succeeded today
# This is a no-op after any successful pass. A real retry spends one transaction
# request per account. The separate weekly balance check spends another request
# on its day and is not represented by the lines rendered below.

[Timer]
{{WATCHDOG_TIMES}}
Persistent=true

[Install]
WantedBy=timers.target
