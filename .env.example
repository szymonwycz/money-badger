# Money Badger configuration. Copy to .env — install.sh writes one for you.
# Everything here is optional except the password, and even that only if the
# app is reachable from anywhere but your own machine.

# ── Web app ───────────────────────────────────────────────────────────────────

# Hash, never the password itself. Generate one with:
#   venv/bin/python -c "from werkzeug.security import generate_password_hash as h; \
#                       print(h(input('password: ')))"
# Empty disables the login entirely: every endpoint, including the full ledger
# export and DELETE, becomes reachable by anyone who can connect.
MB_PASSWORD_HASH=

# The account MB_PASSWORD_HASH becomes on first start. Read only on the run that
# creates it — after that, accounts live in the database and are managed from the
# ACCOUNT tab, so changing a password never means editing this file.
MB_ADMIN_USER=admin

# Signs the session cookie. Changing it logs everyone out; leaving it empty
# generates a new one per process, which logs everyone out on every restart.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Lets the sync pipeline call the API without a browser session. Same generator
# as SECRET_KEY. Needed only when MB_PASSWORD_HASH is set.
MB_API_TOKEN=

# Where the database lives. Defaults to budget.db next to app.py.
#BUDGET_DB=

# ── Sync pipeline (optional) ──────────────────────────────────────────────────

# Where the pipeline reaches the web app. The default assumes both run on the
# same host; set it if they don't.
#BUDGET_URL=http://127.0.0.1:5055

# ── Categorization (optional) ─────────────────────────────────────────────────
#
# Without any of these the pipeline still works: keyword rules categorize
# what they can and everything else lands in CHECK ME, where each correction
# you make teaches a new rule.

# Hosted: pick a provider and fill in its key. One key per provider, so the
# others can stay in the file while you try something else.
#
#   anthropic   ANTHROPIC_API_KEY
#   openai      OPENAI_API_KEY
#   deepseek    DEEPSEEK_API_KEY
#   moonshot    MOONSHOT_API_KEY    (Kimi)
#   gemini      GEMINI_API_KEY
#   xai         XAI_API_KEY         (Grok)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#DEEPSEEK_API_KEY=
#MOONSHOT_API_KEY=
#GEMINI_API_KEY=
#XAI_API_KEY=

# Which model to use. No model ids are pinned in the code: install.sh asks the
# provider what it currently offers and writes your choice here, and
#   venv/bin/python sync/llm.py --models
# prints the same list later. Empty is fine on Anthropic — a cheap model
# categorizes and a stronger one learns rules. If the id here is ever retired,
# the pipeline picks the nearest model of the same family and says so in the
# log; put that id here to make the change permanent.
#LLM_MODEL=

# Or local / any OpenAI-compatible server (Ollama, LM Studio, vLLM). A base URL
# overrides the provider's own, which is all a local server is: the same API
# somewhere else. Most of them want no key.
#LLM_PROVIDER=openai
#LLM_BASE_URL=http://127.0.0.1:11434/v1
#LLM_MODEL=qwen3:30b
#LLM_API_KEY=

# ── Notifications (optional) ──────────────────────────────────────────────────

# A Telegram message after each sync and a morning report from the nightly audit.
# Create a bot with @BotFather, then get your chat id from @userinfobot — the
# README has the four steps. Give this app its own bot; don't reuse one that
# other scripts already hold the token for.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Order matching from email (optional) ──────────────────────────────────────
#
# Reads order confirmations to fill in what a card payment actually bought.
# Allegro is parsed directly; Amazon, eBay, Temu and AliExpress go through the
# LLM, which reads the whole message. Which shops, and which folder each one
# lives in, is set in sync/config.json under "order_matching".
#
# Use an app password where the provider offers one. Implicit TLS only — a
# server that speaks STARTTLS and nothing else will not connect.
MAIL_ADDRESS=
MAIL_PASSWORD=
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993

# GMAIL_ADDRESS and GMAIL_APP_PASSWORD are still read as fallbacks, so an
# install predating the rename keeps working untouched.
